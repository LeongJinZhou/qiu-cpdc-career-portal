{
  "name": "qiu/cpdc-portal-api",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.3",
    "firebase/php-jwt": "7.2.1",
    "guzzlehttp/guzzle": "8.2.1",
    "guzzlehttp/psr7": "3.2.0",
    "opis/json-schema": "2.6.0",
    "smalot/pdfparser": "2.13.1"
  },
  "autoload": { "psr-4": { "Cpdc\\": "src/" } },
  "autoload-dev": { "psr-4": { "Cpdc\\Tests\\": "tests/" } },
  "config": { "sort-packages": true, "optimize-autoloader": true },
  "require-dev": {
    "phpstan/phpstan": "2.3.3",
    "phpunit/phpunit": "11.5.57",
    "squizlabs/php_codesniffer": "4.0.4"
  }
}
