{
  "$comment": "PUT /api/network/mentoring: an alumnus offers mentoring (or pauses it with active false).",
  "type": "object",
  "additionalProperties": false,
  "required": ["active", "topics", "slots_per_month"],
  "properties": {
    "active": { "type": "boolean" },
    "topics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": { "type": "string", "minLength": 2, "maxLength": 40, "pattern": "\\S" }
    },
    "slots_per_month": { "type": "integer", "minimum": 1, "maximum": 10 }
  }
}
