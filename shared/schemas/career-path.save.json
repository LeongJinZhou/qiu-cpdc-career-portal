{
  "$comment": "POST /api/career-paths and PUT /api/career-paths/{id}. A step with an id keeps its id (and everyone's ticks); a step left out is removed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["programme", "title", "skills", "steps"],
  "properties": {
    "programme": { "type": "string", "minLength": 1, "maxLength": 200 },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "summary": { "type": "string", "maxLength": 2000 },
    "skills": { "type": "array", "maxItems": 30, "items": { "type": "string", "minLength": 1, "maxLength": 80 } },
    "steps": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title"],
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "detail": { "type": "string", "maxLength": 1000 }
        }
      }
    }
  }
}
