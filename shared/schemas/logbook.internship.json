{
  "$comment": "PUT /api/logbook/internship: the student's internship and their industry supervisor.",
  "type": "object",
  "additionalProperties": false,
  "required": ["company", "supervisor_name", "supervisor_email", "start_date", "end_date"],
  "properties": {
    "company": { "type": "string", "minLength": 2, "maxLength": 200 },
    "supervisor_name": { "type": "string", "minLength": 2, "maxLength": 200 },
    "supervisor_email": { "type": "string", "format": "email", "maxLength": 254 },
    "start_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "end_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  }
}
