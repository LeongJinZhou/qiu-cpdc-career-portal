{
  "$comment": "POST /api/interview/questions (field and question required) and PUT /api/interview/questions/{id} (any).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "field": { "type": "string", "minLength": 2, "maxLength": 80, "pattern": "\\S" },
    "question": { "type": "string", "minLength": 10, "maxLength": 500 },
    "tip": { "type": "string", "maxLength": 500 },
    "active": { "type": "boolean" }
  }
}
