{
  "$comment": "POST /api/logbook/entries and PUT /api/logbook/entries/{id}: one week of the logbook, saved as a draft.",
  "type": "object",
  "additionalProperties": false,
  "required": ["week_start", "hours", "activities", "learnings"],
  "properties": {
    "week_start": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "hours": { "type": "integer", "minimum": 0, "maximum": 80 },
    "activities": { "type": "string", "minLength": 10, "maxLength": 4000 },
    "learnings": { "type": "string", "maxLength": 4000 }
  }
}
