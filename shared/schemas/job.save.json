{
  "$comment": "POST /api/jobs/manage and PUT /api/jobs/manage/{id}: a job or internship. skills = the level (1-5) the job asks for per skill area.",
  "type": "object",
  "additionalProperties": false,
  "required": ["employer_id", "title", "job_type", "location", "closing_date", "description"],
  "properties": {
    "employer_id": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S" },
    "job_type": { "enum": ["full_time", "part_time", "internship", "contract"] },
    "location": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S" },
    "closing_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "description": { "type": "string", "minLength": 1, "maxLength": 10000, "pattern": "\\S" },
    "status": { "enum": ["draft", "open", "closed"] },
    "skills": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["area_id", "level"],
        "properties": {
          "area_id": { "type": "integer", "minimum": 1 },
          "level": { "type": "integer", "minimum": 1, "maximum": 5 }
        }
      }
    }
  }
}
