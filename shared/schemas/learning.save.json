{
  "$comment": "Text fields of POST /api/learning (multipart). Needs link_url or the PDF file field 'proof' (or both).",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "name", "provider", "completed_on"],
  "properties": {
    "kind": { "enum": ["course", "certificate"] },
    "name": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S" },
    "provider": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S" },
    "completed_on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "link_url": { "anyOf": [{ "const": "" }, { "type": "string", "maxLength": 500, "pattern": "^https?://[^\\s/$.?#][^\\s]*$" }] }
  }
}
