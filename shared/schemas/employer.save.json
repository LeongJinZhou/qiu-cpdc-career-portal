{
  "$comment": "POST /api/employers and PUT /api/employers/{id}: one employer in CPDC's directory.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name"],
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S" },
    "industry": { "type": "string", "maxLength": 200 },
    "website": { "anyOf": [{ "const": "" }, { "type": "string", "maxLength": 300, "pattern": "^https?://[^\\s/$.?#][^\\s]*$" }] },
    "location": { "type": "string", "maxLength": 200 },
    "about": { "type": "string", "maxLength": 3000 },
    "active": { "type": "boolean" }
  }
}
