{
  "name": "qiu-cpdc-portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,fakes,web \"npm:dev:api\" \"npm:dev:fakes\" \"npm:dev:web\"",
    "dev:api": "node tools/php-dev-server.mjs 8090 api/public/index.php",
    "dev:fakes": "node tools/php-dev-server.mjs 8091 api/tests/fakes/server.php",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "package:exabytes": "node tools/package-exabytes.mjs",
    "lint": "eslint . && php api/vendor/bin/phpcs -d memory_limit=512M --standard=api/phpcs.xml",
    "typecheck": "tsc --noEmit && php api/vendor/bin/phpstan analyse -c api/phpstan.neon --no-progress --memory-limit=512M",
    "test": "npm run test:api",
    "test:api": "php api/vendor/bin/phpunit -c api/phpunit.xml",
    "test:e2e": "php api/bin/migrate.php && php api/bin/seed.php && playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "concurrently": "10.0.6",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/outfit": "5.3.0",
    "lucide-react": "1.80.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "engines": {
    "node": ">=22"
  }
}
