# Copy to .env and point at your local Postgres instance.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cpdc?schema=public"

# Secret used to sign supervisor magic-link tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MAGIC_LINK_SECRET=""

# Optional supervisor approval email provider. Leave blank for standalone mode;
# the UI will show a copyable magic link instead.
RESEND_API_KEY=""
EMAIL_FROM="CPDC <no-reply@cpdc.qiu.edu.my>"

# Authentication provider mode. Use "firebase-google" for the real auth path.
# "demo" is allowed only for local development/UI smoke tests and must never
# be used in production.
AUTH_MODE=""
NEXT_PUBLIC_AUTH_MODE=""

# Secret used to sign the HTTP-only application session cookie.
SESSION_SECRET=""

# Firebase Web SDK config for the browser login page.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""

# Firebase Admin service-account values for server-side ID-token verification.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# One-time fresh-install bootstrap. Pass these only for
# `npm run db:bootstrap-admin`, then remove them after it succeeds.
BOOTSTRAP_SUPER_ADMIN_EMAIL=""
BOOTSTRAP_SUPER_ADMIN_NAME=""

# Future ACMS/SIS adapter gate. Leave disabled/blank until a real provider and
# endpoint are supplied. No credentials belong in this file.
ACMS_SIS_ENABLED=""
ACMS_SIS_PROVIDER=""
ACMS_SIS_ENDPOINT=""
