# Copy to .env for local development. Never commit .env. Values here are fakes for local use and CI only.
APP_ENV=local
APP_URL=http://127.0.0.1:5183
STORAGE_DIR=storage
DEFAULT_ORGANISATION_ID=1

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cpdc
DB_USER=cpdc
DB_PASSWORD=local-dev-only

# The one super admin (docs/SPEC.md rule 3).
SUPERADMIN_EMAIL=superadmin@example.test

# Google sign-in. Locally these point at the fake Google (npm run dev:fakes); in production at Google.
GOOGLE_CLIENT_ID=fake-google-client
GOOGLE_CLIENT_SECRET=fake-google-secret
GOOGLE_OIDC_BASE=http://127.0.0.1:8091/google
GOOGLE_PEOPLE_BASE=http://127.0.0.1:8091/google

# LinkedIn sign-in (OpenID Connect). Locally the fake LinkedIn; in production https://www.linkedin.com.
LINKEDIN_CLIENT_ID=fake-linkedin-client
LINKEDIN_CLIENT_SECRET=fake-linkedin-secret
LINKEDIN_OAUTH_BASE=http://127.0.0.1:8091/linkedin
LINKEDIN_API_BASE=http://127.0.0.1:8091/linkedin-api

# GitHub link (optional). Empty = the GitHub button is hidden.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_BASE=https://github.com
GITHUB_API_BASE=https://api.github.com
